{
  "version": 1,
  "course": "ECON 416",
  "title": "Zelda Seating — room layout (single source of truth for renderer + seeder)",
  "coordinate_system": {
    "origin": "blackboard; instructor stands at the board facing the class",
    "columns": "1..13, numbered from the INSTRUCTOR'S RIGHT (screen-left in the student-view render)",
    "rows": "0 = floor row nearest the board; 1..10 tiered, climbing to the back; 10 = back-wall row",
    "render_view": "student view: board at top, row index increases downward, col index increases rightward"
  },
  "grid": {
    "seat_rows": [
      0,
      10
    ],
    "seat_cols": [
      1,
      13
    ],
    "render_extent": {
      "rowMin": -1,
      "rowMax": 11,
      "colMin": 0,
      "colMax": 14
    },
    "notes": "row -1 = front wall / board band; row 11 = back-wall band; col 0 = left wall; col 14 = right wall. Seats live in rows 0..10, cols 1..13."
  },
  "counts": {
    "seats": 134,
    "tiered": 130,
    "floor": 4,
    "left_handed": 11,
    "right_handed": 123,
    "reserved": 6,
    "off_limits": 52,
    "claimable": 76
  },
  "features": [
    {
      "type": "board",
      "label": "blackboard",
      "span": {
        "row": -1,
        "colStart": 1,
        "colEnd": 13
      }
    },
    {
      "type": "monster",
      "label": "instructor",
      "variant": "moblin",
      "swappable": [
        "moblin",
        "aquamentus"
      ],
      "cell": {
        "row": 0,
        "col": 7
      },
      "note": "front-centre, in row 0's centre gap (cols 5-9 have no seat); faces the class. Renderer may nudge toward the board."
    },
    {
      "type": "cave",
      "label": "front door",
      "corner": "front-left",
      "cell": {
        "row": 0,
        "col": 1
      },
      "note": "row 0 has no col-1 seat, so no seat is displaced."
    },
    {
      "type": "cave",
      "label": "back door",
      "corner": "back-left",
      "cell": {
        "row": 11,
        "col": 1
      },
      "note": "row 11 = past the back wall; no seat exists there."
    },
    {
      "type": "wall",
      "label": "dungeon perimeter",
      "perimeter": true,
      "openings": [
        {
          "row": 0,
          "col": 1
        },
        {
          "row": 11,
          "col": 1
        }
      ],
      "note": "walls ring the render_extent; the two cave cells are openings, not wall."
    }
  ],
